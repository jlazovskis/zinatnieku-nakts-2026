    @In(2) void thIn(int value) { th = value; }
    int lv = 10;
    @In(3) void lvIn(int value) { lv = value; }
    
    @Override
    public void setup() {
    }

    @Override
    public void draw() {
       
        // show input
        image(in,0,0);
        
        // overlay with text
        fill(255);
        textSize(24);
        text("izšķirtspēja: "+cc, 20, 40);
        text("melnā slieksnis: " + th + "/" + lv, 20, 70);
    }
}
  }
  @ ./snapshot-1 video:snapshot {
    .meta [map graph.x 1279 graph.y 121 graph.comment "hold when screencap"]
    .code {
@In(1) PImage in;

@T(1) boolean trigger;
@T(2) boolean reset;

@OffScreen PGraphics bg;

boolean frozen = false;

@Override
public void draw() {
    if (reset) {
        reset();
        reset = false;
    }

    if (trigger) {
        trigger = false;

        if (!frozen) {
            // Capture the current live frame
            bg.copy(in);
            frozen = true;
        } else {
            // Resume live video
            frozen = false;
        }
    }

    if (frozen) {
        image(bg, 0, 0);
    } else {
        image(in, 0, 0);
    }
}

void reset() {
    frozen = false;
    bg.clear();
}
    
}
  }
  @ ./delay-1 core:timing:delay {
    .meta [map graph.x 1292 graph.y 422]
    .time 5
  }
  ~ ./start-trigger-1!out ./capture-1!play
  ~ ./capture-1!out ./custom-1!in
  ~ ./custom-1!out ./composite-1!in
  ~ ./custom-1!out ./custom-2!in
  ~ ./custom-2!out ./p2d-1!in
  ~ ./p2d-1!out ./custom-3!in
  ~ ./p2d-1!screencap-now ./custom-2!screencap-now
  ~ ./p2d-1!screencap-now ./custom-3!screencap-now
  ~ ./p2d-2!out ./custom-4!in
  ~ ./custom-2!out ./p2d-2!in
  ~ ./p2d-1!screencap-now ./custom-4!screencap-now
  ~ ./custom-4!out ./composite-1!src-tmp
  ~ ./custom-4!done-grayscale ./custom-6!done-grayscale
  ~ ./custom-2!done-source ./custom-6!done-source
  ~ ./custom-3!out ./p2d-3!in
