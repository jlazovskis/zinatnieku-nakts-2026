    Path pendingOverlayFile;
    
    @Override
    public void init() {
        pendingOverlayPNG = null;
        pendingOverlayFile = null;
    }

    @Override
    public void draw() {
        
        // Check every frame what is happening to overlay
        if (pendingOverlayPNG != null && pendingOverlayPNG.done()) {
            try {
                if (pendingOverlayPNG.failed()) {
                    System.out.println("PNG encoding of overlay failed:");
                    System.out.println(pendingOverlayPNG.error());
                } else {
                    PBytes png = pendingOverlayPNG.result();
                    Files.copy( png.asInputStream(), pendingOverlayFile, StandardCopyOption.REPLACE_EXISTING );
                    doneOverlay.send(); }
            } catch (Exception e) {
                System.out.println("PNG overlay export error:");
                System.out.println(e);
            } finally {
                pendingOverlayPNG = null;
                pendingOverlayFile = null; } }
        
        if (in == null) { return; }
        
        // Export overlay
        if (exporting && pendingOverlayPNG == null) {
            pendingOverlayFile = Paths.get( outputDir, "overlay_groundtruth.png" );
            pendingOverlayPNG = write( MIME_PNG, in );
            
            System.out.println( " * Exported overlay_groundtruth.png" );
            exporting = false;
        }
        copy(in); 
        release(in);
    }    
    
}
