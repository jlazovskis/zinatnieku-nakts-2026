  ~ ./p2d-1!cc-out ./p2d-2!cc-in
  ~ ./p2d-3!out ./composite-1!src
  ~ ./p2d-1!th-out ./p2d-3!th-in
  ~ ./custom-3!done-overlay ./custom-6!done-overlay
  ~ ./p2d-1!lv-out ./p2d-3!lv-in
  ~ ./p2d-1!lv-out ./p2d-2!lv-in
  ~ ./composite-1!out ./snapshot-1!in
  ~ ./p2d-1!screencap-now ./delay-1!in
  ~ ./p2d-1!screencap-now ./snapshot-1!trigger
  ~ ./delay-1!out ./snapshot-1!reset
  ~ ./snapshot-1!out ./screen!in
