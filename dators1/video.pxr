  @ ./p2d-1 video:gl:p2d {
    .meta [map graph.x 729 graph.y 121 graph.comment "pixelate and highlight"]
    .code {
    @In(1) PImage in;
    @P(1) @Type.String(mime = GLSL_FRAGMENT_MIME) String fragment = "";
    PShader shader;
    
    // Screenshot setup
    String prefix = "/home/janis/PraxisLIVE Projects/zinatnieku-nakts/screenshots";
    @Out(1) Output screencapNow;
    boolean wasSpace = false;
    
    // Pixel change setup
    @Out Output ccOut;
    int coeff = 0;
    boolean wasUp = false;
    boolean wasDown = false;
    int[] cellCountX = {10, 12, 18, 28, 42, 60, 80, 100, 140, 170, 200, 250, 300, 350, 400, 450, 520, 580, 650, 720, 800};
    void nextCoeff() { 
        coeff = (coeff+1) % cellCountX.length;
        ccOut.send(cellCountX[coeff]);
    };
    void prevCoeff() {
        coeff = (((coeff-1) % cellCountX.length) + cellCountX.length ) % cellCountX.length; // loops back to top
        ccOut.send(cellCountX[coeff]);
    };
    @Out(2) Output upCoeff;
    @Out(3) Output downCoeff;
    
    // Threshold setup
    @Out Output thOut;
    float threshold = 0.0f;
    boolean wasLeft = false;
    boolean wasRight = false;
    void nextThreshold() { 
        threshold = Math.min(threshold+1.0f, levels);
        thOut.send(threshold);
    };
    void prevThreshold() {
        threshold = Math.max(threshold-1.0f, 0.0f);
        thOut.send(threshold);
    };
    
    // Levels setup
    @Out Output lvOut;
    float levels = 10.0f;
    boolean wasZ = false;
    boolean wasX = false;
    void nextLevel() { 
        levels = Math.min(levels+1.0f, 20.0f);
        lvOut.send(levels);
    };
    void prevLevel() {
        levels = Math.max(levels-1.0f, 5.0f);
        lvOut.send(levels);
        threshold = Math.min(threshold, levels);
        thOut.send(threshold);
    };

    @Override
    public void setup() {
        shader = createShader(DEFAULT_VERTEX_SHADER,fragment);
    }
    
    @Override
    public void draw() {
        
        // Input size is 800x600 (or 1920x1080?)
        shader(shader);
        
        // Pixel change
        boolean upbutton = keyPressed && keyCode == 38;
        if (upbutton && !wasUp ) { 
            nextCoeff();
            upCoeff.send(); } 
        wasUp = upbutton;
        boolean downbutton = keyPressed && keyCode == 40;
        if (downbutton && !wasDown ) {
            prevCoeff();
            downCoeff.send(); } 
        wasDown = downbutton;
        
        // Threshold change
        boolean leftbutton = keyPressed && keyCode == 39;
        if (leftbutton && !wasLeft ) { nextThreshold(); } 
        wasLeft = leftbutton;
        boolean rightbutton = keyPressed && keyCode == 37;
        if (rightbutton && !wasRight ) { prevThreshold(); } 
        wasRight = rightbutton;
        
        // Levels change
        boolean zbutton = keyPressed && keyCode == 88; // actually X
        if (zbutton && !wasZ ) { nextLevel(); } 
        wasZ = zbutton; 
        boolean xbutton = keyPressed && keyCode == 90; // actually Z
        if (xbutton && !wasX ) { prevLevel(); } 
        wasX = xbutton;
    
        // Shader        
        // shader.set("gridSizeX", 19.20f + coeff*19.20f);
        // shader.set("gridSizeY", 10.80f + coeff*10.80f);

        shader.set("gridSizeX", 1920.0f / cellCountX[coeff]);
        shader.set("gridSizeY", 1920.0f / cellCountX[coeff]);        
        
        shader.set("levels", levels);        
        shader.set("levelCutoff", threshold);   
        
        // shader.set("threshold", 0.5f);        
        
        image(in,0,0);
        resetShader();

        // Screenshot
        boolean spacebutton = keyPressed && keyCode == 32;
        if (spacebutton && !wasSpace ) { screencapNow.send(); } 
        wasSpace = spacebutton;
                
        // Overlay
        // fill(255);
        // textSize(24);
        // text(cellCountX[coeff], 20, 40);
        
    }

}
    .fragment {#ifdef GL_ES
precision mediump float;
precision mediump int;
#endif
 
uniform sampler2D texture;
uniform vec2 texOffset;
uniform float gridSizeX;
uniform float gridSizeY;
uniform float levels;
uniform float levelCutoff;
 
varying vec4 vertColor;
varying vec4 vertTexCoord;
 
void main() {
 
    vec2 uv = vertTexCoord.st;

    // Size of one grid cell in texture coordinates
    vec2 cellSize = vec2(gridSizeX/1920.0f, gridSizeY/1080.0f);
 
    // Which cell are we in?
    vec2 cell = floor(uv / cellSize);
 
    // Centre of that cell
    vec2 cellCentre = (cell + 0.5) * cellSize;
 
    // Number of samples across each cell
    const int samplesX = 20;
    const int samplesY = 20;
 
    vec3 total = vec3(0.0); // color or grayscale
    float totalGray = 0.0; // grayscale
    // float total = 0.0; // threshold
 
    for (int y = 0; y < samplesX; y++) {
        for (int x = 0; x < samplesY; x++) {
 
            vec2 offset = vec2(
                (float(x) + 0.5) / float(samplesX) - 0.5,
                (float(y) + 0.5) / float(samplesY) - 0.5
            );
 
            vec2 sampleUV = cellCentre + offset * cellSize;
 
            // total += texture2D(texture, sampleUV).rgb; // color

            float thisGray = dot(texture2D(texture, sampleUV).rgb, vec3(.299, .587, .114)); // grayscale
            total += vec3(thisGray, thisGray, thisGray); // grayscale
            totalGray += thisGray; // grayscale

            // if ( thisGray < threshold ) { // highlight
            //     total += vec3(0,1,0);
            // } else { total += vec3(thisGray, thisGray, thisGray); }



            //if ( dot(texture2D(texture, sampleUV).rgb, vec3(.299, .587, .114)) > threshold ) { // threshold
            //    total += 1;
            //} else {
            //    total += 0;
            //}


        }
    }
 
    // vec3 average = total / float(samplesX * samplesY); // color or grayscale
    // gl_FragColor = vec4(average, 1.0); // color or grayscale

    float averageGray = totalGray / float(samplesX * samplesY); // quantized
    float quantized = floor(averageGray * (levels-1) + 0.5) / (levels-1);
    if ( quantized <= levelCutoff/(levels-1)) {
        gl_FragColor = vec4(0,1,0, 1.0);
    } else {   
        gl_FragColor = vec4(quantized, quantized, quantized, 1.0);
    }

    // float average = total / float(samplesX * samplesY); // threshold
    // gl_FragColor = vec4(average, average, average, 1.0); // threshold
}}
  }
  @ ./composite-1 video:composite {
    .meta [map graph.x 1020 graph.y 121 graph.comment "combine foreground and background"]
    .code {
    @In(1) PImage in;
    @In(2) PImage src;
    @In(2) PImage src_tmp;

    @P(1) BlendMode mode;
    @P(2) @Type.Number(min = 0, max = 1, def = 1) double mix;
    @P(3) boolean forceAlpha;

    @Persist Async<PBytes> watchInResponse, watchSrcResponse;

    @Override
    public void init() {
        attachAlphaQuery("src", outAlpha -> outAlpha || forceAlpha);
    }

    @Override
    public void draw() {
        checkWatches();
        copy(in);
        release(in);
        blendMode(mode, mix);
        image(src, 0, 0);
    }

    @FN.Watch(mime = MIME_PNG, relatedPort = "in")
    Async<PBytes> watchIn() {
        if (watchInResponse == null || watchInResponse.failed()) {
            watchInResponse = timeout(1, new Async<>());
        }
        return watchInResponse;
    }

    @FN.Watch(mime = MIME_PNG, relatedPort = "src")
    Async<PBytes> watchSrc() {
        if (watchSrcResponse == null || watchSrcResponse.failed()) {
            watchSrcResponse = timeout(1, new Async<>());
        }
        return watchSrcResponse;
    }

    private void checkWatches() {
        double size = max(width, height);
        double scale = size > 800 ? 400 / size : 0.5;
        if (watchInResponse != null) {
            Async.bind(write(MIME_PNG, in, scale), watchInResponse);
            watchInResponse = null;
        }
        if (watchSrcResponse != null) {
            Async.bind(write(MIME_PNG, src, scale), watchSrcResponse);
            watchSrcResponse = null;
        }
    }

}
    .mix 0.7
  }
