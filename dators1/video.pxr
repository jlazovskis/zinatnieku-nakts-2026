    .code {import java.awt.KeyboardFocusManager;
import java.awt.KeyEventDispatcher;
import java.awt.event.KeyEvent;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.time.Instant;
// import java.io.InputStream;
// import java.awt.image.BufferedImage;
// import javax.imageio.ImageIO;

    
    @In(1) PImage in;
    
    // Screenshot setup
    String outputDir = "/home/janis/PraxisLIVE Projects/zinatnieku-nakts/screenshots/";
    boolean exporting = false;
    @T(2) void screencapNow() { exporting = true; }
    @Out(1) Output doneSource;
    Async<PBytes> pendingPNG;
    Path pendingFile;
    
    @Override
    public void init() {
        pendingPNG = null;
        pendingFile = null;
    }

    @Override
    public void draw() {
        
        if (pendingPNG != null && pendingPNG.done()) {
            try {
                if (pendingPNG.failed()) {
                    System.out.println("PNG encoding failed:");
                    System.out.println(pendingPNG.error());
                } else {
                    PBytes png = pendingPNG.result();
                    
                    // DEBUG START
                    // try (InputStream in = png.asInputStream()) {
                    //     BufferedImage image = ImageIO.read(in);
                    //     System.out.println(image.getWidth() +" x "+image.getHeight());}
                    // System.out.println("export input: " + in.width + " x " + in.height);
                    // DEBUG END
                    
                    Files.copy( png.asInputStream(), pendingFile, StandardCopyOption.REPLACE_EXISTING );
                    doneSource.send();
                }
            } catch (Exception e) {
                System.out.println("PNG export error:");
                System.out.println(e);
            } finally {
                pendingPNG = null;
                pendingFile = null;
            }
        }

        if (in == null) { return; }
        if (exporting && pendingPNG == null) {
            pendingFile = Paths.get( outputDir, "source.png" );
            pendingPNG = write( MIME_PNG, in );
            System.out.println( " * Exported source.png" );
            exporting = false;
        }
        copy(in);
        release(in);
    }    
    
}
  }
