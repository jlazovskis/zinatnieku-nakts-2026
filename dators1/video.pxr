@ /video root:video {
  .renderer OpenGL
  .width 1280
  .height 720
  .fps 60.0
  .smooth false
  @ ./screen video:output {
    .meta [map graph.x 1541 graph.y 121 graph.comment "final render"]
    .device 2
    .width 3840
    .height 2160
    .rotation 0
    .undecorated true
    .show-cursor true
