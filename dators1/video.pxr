  @ ./custom-6 core:custom {
    .meta [map graph.x 1029 graph.y 636 graph.comment "send exports
"]
    .code {import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.time.Instant;
import java.lang.ProcessBuilder;

    
    // Screenshot setup
    String sourceDir = "/home/janis/PraxisLIVE Projects/zinatnieku-nakts/screenshots/";
    String targetDir = "/home/janis/Documents/Darbi - algoti/2025-03 Latvijas Universitate/Projekti/2026-06-05 Zinatnieku nakts/screenshots";
    boolean exporting = false;
    boolean receivedSource = false;
    boolean receivedGrayscale = false;
    boolean receivedOverlay = false;
    @T(1) void doneSource() { receivedSource = true; }
    @T(2) void doneGrayscale() { receivedGrayscale = true; }
    @T(3) void doneOverlay() { receivedOverlay = true; }    

    // Levels setup
    float lv = 10.0f;
    @In(2) void lvIn(int value) { lv = value; }
    
    @Override
    public void init() {

    }

    
    @Override
    public void update() {

        if ( receivedSource && receivedGrayscale && receivedOverlay ) {
            exporting = true;
        }
        
        if ( exporting ) {

            // Write level to file
            String cmd = "echo \"" + lv + "\" > \"" + sourceDir + "levels.txt\"";
            try {
                ProcessBuilder pb = new ProcessBuilder("bash", "-c", cmd);
                Process p = pb.start();
                p.waitFor();
                System.out.println( " * Wrote levels to file" );
            } catch (Exception e) { System.out.println(" * ERROR");}
            
            // Export
            cmd = "scp \"" +
                    sourceDir + "source.png\" \"" + 
                    sourceDir + "grayscale.png\" \"" + 
                    sourceDir + "overlay_groundtruth.png\" \"" + 
                    sourceDir + "levels.txt\" " + 
                    "janis@192.168.50.2:\"" + targetDir + "\"";
            try {
                ProcessBuilder pb = new ProcessBuilder("bash", "-c", cmd);
                Process p = pb.start();
                p.waitFor();
                System.out.println( Instant.now().toString().substring(11,19) + " : Sent 3 images and 1 text file" );
            } catch (Exception e) { System.out.println(" * ERROR");}
                      
            
            receivedSource = false;
            receivedGrayscale = false;
            receivedOverlay = false;
            exporting = false;
        }        
        
    }
    
}
  }
